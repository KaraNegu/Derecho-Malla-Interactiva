body {
  margin: 0;
  font-family: 'Inter', sans-serif;
  background-color: #f7f7f7;
  color: #333;
}

header {
  padding: 1rem;
  background-color: #003366;
  color: white;
  text-align: center;
}

main {
  padding: 1rem;
  overflow-x: auto;
}

.malla-container {
  display: flex;
  gap: 1rem;
  padding: 1rem;
  flex-wrap: wrap;
  justify-content: center;
}

.semestre {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  min-width: 220px;
}

.semestre h2 {
  text-align: center;
  margin-bottom: 0.5rem;
  background-color: #ddd;
  padding: 0.5rem;
  border-radius: 0.5rem;
}

.curso {
  position: relative;
  border-radius: 0.5rem;
  padding: 1rem;
  background-color: #fff;
  box-shadow: 0 2px 6px rgba(0,0,0,0.05);
  cursor: pointer;
  border: 2px solid transparent;
  transition: border-color 0.2s, background 0.2s;
  margin-bottom: 0.5rem;
  opacity: 1;
  pointer-events: auto;
}

.curso.aprobado {
  background-color: #d4edda;
  border-color: #28a745;
}

.curso.bloqueado {
  background-color: #eee;
  color: #aaa;
  opacity: 0.6;
  pointer-events: none;
}

.curso:hover:not(.bloqueado) {
  border-color: #003366;
  background-color: #e9ecef;
}

.curso .nombre {
  font-weight: 600;
}

.curso .creditos {
  font-size: 0.9em;
  color: #666;
  margin-top: 0.2em;
}

.curso .prereq {
  font-size: 0.8em;
  color: #b00;
  margin-top: 0.2em;
}

footer {
  padding: 1rem;
  background-color: #eee;
  text-align: center;
  font-size: 1.2em;
}

.creditos {
  font-weight: 600;
  color: #003366;
}
