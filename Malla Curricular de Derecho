const aprobadas = new Set();

function creditosAprobados() {
  return materias.reduce((acc, m) =>
    acc + (aprobadas.has(m.codigo) ? m.creditos : 0), 0
  );
}

function generarMalla() {
  const cont = document.getElementById("malla");
  cont.innerHTML = "";
  materias.forEach(m => {
    let bloqueado = m.requisito.length > 0 && !m.requisito.every(r => aprobadas.has(r));
    let electiva = m.tipo === 'electiva';

    let div = document.createElement("div");
    div.className = "cuadro-ramo" + (aprobadas.has(m.codigo) ? " aprobado" : "") + (bloqueado ? " bloqueado" : "") + (electiva ? " electiva" : "");

    div.innerHTML = `
      <div class="titulo">${m.nombre}</div>
      <div class="codigo">${m.codigo} - ${m.tipo.charAt(0).toUpperCase()+m.tipo.slice(1)}</div>
      <div class="creditos">Créditos: ${m.creditos}</div>
      <div class="reqs">${m.requisito.length ? "Requiere: " + m.requisito.join(', ') : ""}</div>
      <button class="boton">
        ${electiva ? (aprobadas.has(m.codigo) ? "Elegido" : "Elegir") : (aprobadas.has(m.codigo) ? "Aprobado" : "Aprobar")}
      </button>
    `;
    div.querySelector(".boton").onclick = function () {
      if (!aprobadas.has(m.codigo)) aprobadas.add(m.codigo);
      else if (electiva) aprobadas.delete(m.codigo);
      generarMalla();
      document.getElementById("creditos-aprobados").textContent = creditosAprobados();
    };
    cont.appendChild(div);
  });

  document.getElementById("creditos-aprobados").textContent = creditosAprobados();
}

window.onload = generarMalla;
