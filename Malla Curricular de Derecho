body {
  font-family: Arial, sans-serif;
  background: #fff0f6;
  margin: 0;
  padding: 0;
}
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #e75480;
  color: white;
  padding: 20px;
}
.creditos-totales {
  font-size: 1.2em;
}
#malla {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  padding: 32px;
  justify-content: center;
}
.cuadro-ramo {
  background: #ffb6c1;
  border: 2px solid #e75480;
  border-radius: 12px;
  width: 270px;
  min-height: 140px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.07);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 16px;
  margin-bottom: 10px;
}
.cuadro-ramo .titulo {
  font-weight: bold;
  margin-bottom: 4px;
}
.cuadro-ramo .codigo {
  font-size: 0.9em;
  color: #ae3e7e;
  margin-bottom: 8px;
}
.cuadro-ramo .creditos {
  font-size: 0.95em;
  color: #d84369;
}
.cuadro-ramo .reqs {
  font-size: 0.85em;
  color: #555;
  margin-bottom: 4px;
}
.cuadro-ramo.aprobado {
  background: #c5ffbe !important;
  border: 2px solid #2eae35 !important;
}
.cuadro-ramo.bloqueado {
  filter: grayscale(0.85) opacity(0.6);
  pointer-events: none;
}
.cuadro-ramo.electiva {
  border-style: dashed;
  border-color: #ec80ac;
}
.boton {
  background: #e75480;
  color: #fff;
  border: none;
  border-radius: 6px;
  padding: 8px 12px;
  font-weight: bold;
  cursor: pointer;
  margin-top: 10px;
  transition: background 0.2s;
}
.boton:hover {
  background: #d84369;
}
